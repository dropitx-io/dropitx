# DropItX API (FastAPI). Every data call goes through it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional, server-only, read at run time (not a build arg). Address the Next.js server uses to reach the API
# when it differs from the public URL, e.g. an in-cluster service. Defaults to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=

# Firebase web SDK (sign-in)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only): verifies the session cookie
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Public origin of this app (e.g. https://dropitx.site), used to compose absolute links
NEXT_PUBLIC_APP_URL=
# Host of this app without scheme (e.g. dropitx.site). Declared as a Docker image arg; no code reads it today
NEXT_PUBLIC_APP_HOST=
